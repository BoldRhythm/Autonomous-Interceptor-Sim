<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="interceptor_x500">

    <!-- Base X500 model -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- Monocular camera -->
    <include merge="true">
      <uri>model://mono_cam</uri>

      <!-- x y z roll pitch yaw -->
      <pose>0.20 0.00 0.12 0 0 0</pose>
    </include>

    <!-- Attach the camera rigidly to the drone -->
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>

      <pose relative_to="base_link">
        0.20 0.00 0.12 0 0 0
      </pose>
    </joint>

  </model>
</sdf>
